@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - VetCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #eef2f5;
            margin: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-container {
            display: flex;
            width: 1000px;
            max-width: 95%;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);
            overflow: hidden;
            min-height: 600px;
        }
        .login-left {
            width: 50%;
            background: linear-gradient(135deg, #1B263B 0%, #0d131f 100%);
            padding: 50px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
        }
        .login-left::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23ffffff' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.6;
        }
        .login-left i {
            font-size: 5.5rem;
            margin-bottom: 25px;
            animation: float 4s ease-in-out infinite;
            z-index: 1;
            text-shadow: 0 10px 20px rgba(0,0,0,0.2);
            color: #FF9F1C;
        }
        .login-left h2, .login-left p {
            z-index: 1;
        }
        .login-right {
            width: 50%;
            padding: 80px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .form-control {
            border-radius: 12px;
            padding: 14px 18px;
            border: 2px solid #edf2f7;
            background-color: #f8fafc;
            font-size: 1.05rem;
            transition: all 0.3s;
        }
        .form-control:focus {
            border-color: #FF9F1C;
            box-shadow: 0 0 0 4px rgba(255, 159, 28, 0.15);
            background-color: #fff;
        }
        .input-group-text {
            border: 2px solid #edf2f7;
            background-color: #f8fafc;
            color: #a0aec0;
        }
        .form-control:focus + .input-group-text,
        .input-group:focus-within .input-group-text {
            border-color: #FF9F1C;
            background-color: #fff;
            color: #FF9F1C;
        }
        .btn-login {
            background: #FF9F1C;
            color: white;
            border: none;
            padding: 15px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1.15rem;
            letter-spacing: 0.5px;
            transition: all 0.3s;
            margin-top: 10px;
        }
        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(255, 159, 28, 0.3);
            background: #F4A261;
            color: white;
        }
        .btn-login:active {
            transform: translateY(-1px);
            box-shadow: 0 5px 10px rgba(255, 159, 28, 0.3);
        }
        @@keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
            100% { transform: translateY(0px); }
        }
        @@media (max-width: 768px) {
            .login-container { flex-direction: column; width: 450px; min-height: auto; }
            .login-left, .login-right { width: 100%; }
            .login-left { padding: 50px 20px; border-radius: 24px 24px 0 0; }
            .login-right { padding: 50px 30px; }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-left">
            <i class="bi bi-heart-pulse-fill"></i>
            <h2 class="fw-bold mb-3" style="font-size: 2.5rem;">NetVet</h2>
            <p style="font-size: 1.15rem; opacity: 0.9; font-weight: 300;">Plataforma Premium de Gestión de Salud Animal.</p>
        </div>
        <div class="login-right">
            <h3 class="fw-bold text-dark" style="font-size: 2rem;">¡Bienvenido!</h3>
            <p class="text-muted mb-5" style="font-size: 1.1rem;">Inicia sesión para acceder a tu panel de control</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center" style="border-radius:12px; font-weight: 500;">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i> 
                    <div>@ViewBag.Error</div>
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-4">
                    <label for="username" class="form-label fw-bold text-secondary mb-2" style="font-size: 0.95rem; letter-spacing: 0.5px; text-transform: uppercase;">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0" style="border-radius: 12px 0 0 12px; padding-left: 18px;">
                            <i class="bi bi-person fs-5"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" id="username" name="username" placeholder="Ingresa tu nombre de usuario" required style="border-radius: 0 12px 12px 0; padding-left: 10px;">
                    </div>
                </div>
                <div class="mb-5">
                    <label for="password" class="form-label fw-bold text-secondary mb-2" style="font-size: 0.95rem; letter-spacing: 0.5px; text-transform: uppercase;">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0" style="border-radius: 12px 0 0 12px; padding-left: 18px;">
                            <i class="bi bi-shield-lock fs-5"></i>
                        </span>
                        <input type="password" class="form-control border-start-0" id="password" name="password" placeholder="••••••••" required style="border-radius: 0 12px 12px 0; padding-left: 10px;">
                    </div>
                </div>
                <button type="submit" class="btn btn-login w-100 mb-4">
                    Ingresar al Sistema <i class="bi bi-arrow-right-short fs-4 align-middle ms-1"></i>
                </button>
            </form>
            
            <div class="text-center" style="font-weight: 500;">
                <span class="text-muted">¿No tienes cuenta?</span> 
                <a asp-action="Register" style="color: #FF9F1C; text-decoration: none; font-weight: 600;">Regístrate aquí</a>
            </div>

            <div class="text-center mt-5">
                <span class="text-muted" style="font-size: 0.9rem; font-weight: 500;">&copy; 2026 NetVet - Clínica Veterinaria. Todos los derechos reservados.</span>
            </div>
        </div>
    </div>
</body>
</html>
