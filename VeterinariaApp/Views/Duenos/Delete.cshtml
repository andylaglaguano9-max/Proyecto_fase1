@model VeterinariaApp.Models.Dueno
@{ ViewData["Title"] = "Eliminar Dueño"; }

<div class="page-header" style="background:linear-gradient(135deg,#b71c1c,#e53935);">
    <div class="container">
        <h1><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación</h1>
        <p>Esta acción marcará al propietario como inactivo en el sistema</p>
    </div>
</div>

<div class="main-content">
    <div class="vet-delete-card">
        <div class="delete-header">
            <div class="delete-icon"><i class="bi bi-person-x-fill"></i></div>
            <h4>¿Desactivar este propietario?</h4>
            <p style="opacity:0.85;font-size:0.9rem;margin:0">El registro no se eliminará, solo quedará marcado como inactivo.</p>
        </div>
        <div class="delete-body">
            <div class="detail-field">
                <span class="field-label"><i class="bi bi-person-fill"></i> Nombre</span>
                <span class="field-value" style="font-weight:600">@Model.Nombre @Model.Apellido</span>
            </div>
            <div class="detail-field">
                <span class="field-label"><i class="bi bi-envelope-fill"></i> Correo</span>
                <span class="field-value">@Model.Correo</span>
            </div>
            <div class="detail-field">
                <span class="field-label"><i class="bi bi-telephone-fill"></i> Teléfono</span>
                <span class="field-value">@Model.Telefono</span>
            </div>

            <form asp-action="Delete" style="margin-top:25px">
                <input type="hidden" asp-for="Id" />
                <div style="display:flex;gap:12px;flex-wrap:wrap;">
                    <button type="submit" class="btn-vet-danger">
                        <i class="bi bi-person-x-fill"></i> Sí, desactivar
                    </button>
                    <a asp-action="Index" class="btn-vet-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
