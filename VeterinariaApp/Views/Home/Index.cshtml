@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO -->
<section class="hero-section">
    <div class="hero-badge"><i class="bi bi-check-circle-fill"></i> Sistema activo y funcionando</div>
    <h1><i class="bi bi-heart-pulse-fill"></i> Bienvenido a VetCare</h1>
    <p>Sistema integral de gestión para nuestra Clínica Veterinaria.<br/>Cuida a tus mascotas con el mejor servicio.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a asp-controller="Mascotas" asp-action="Create" class="btn-vet-primary" style="font-size:1rem; padding:12px 28px">
            <i class="bi bi-plus-circle-fill"></i> Nueva Mascota
        </a>
        <a asp-controller="Duenos" asp-action="Create" class="btn-vet-secondary" style="font-size:1rem; padding:12px 28px; color:white; border-color:white;">
            <i class="bi bi-person-plus-fill"></i> Nuevo Dueño
        </a>
    </div>
</section>

<!-- STATS -->
<div class="stats-bar">
    <div class="container">
        <div class="row">
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">5+</div>
                    <div class="stat-label"><i class="bi bi-clipboard2-pulse-fill"></i> Mascotas Registradas</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">5+</div>
                    <div class="stat-label"><i class="bi bi-people-fill"></i> Dueños Activos</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">5+</div>
                    <div class="stat-label"><i class="bi bi-calendar2-check-fill"></i> Citas Agendadas</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">5+</div>
                    <div class="stat-label"><i class="bi bi-person-badge-fill"></i> Veterinarios</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODULES -->
<section class="modules-section">
    <div class="section-title">
        <h2><i class="bi bi-grid-fill"></i> Módulos del Sistema</h2>
        <p>Gestiona toda la información de tu clínica veterinaria desde un solo lugar</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Duenos" asp-action="Index" class="module-card">
                <span class="card-icon"><i class="bi bi-people-fill"></i></span>
                <h4>Dueños</h4>
                <p>Gestiona la información de contacto de los propietarios de mascotas registrados en el sistema.</p>
                <div class="card-arrow">Ver módulo <i class="bi bi-arrow-right"></i></div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Mascotas" asp-action="Index" class="module-card">
                <span class="card-icon"><i class="bi bi-clipboard2-pulse-fill"></i></span>
                <h4>Mascotas</h4>
                <p>Registro completo de los pacientes: nombre, especie, peso, fecha de nacimiento y dueño.</p>
                <div class="card-arrow">Ver módulo <i class="bi bi-arrow-right"></i></div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="module-card" style="opacity:0.6; cursor:default;">
                <span class="card-icon"><i class="bi bi-calendar2-check-fill"></i></span>
                <h4>Citas</h4>
                <p>Agenda y administra las citas médicas de cada mascota con el veterinario correspondiente.</p>
                <div class="card-arrow" style="color:#aaa">Próximamente <i class="bi bi-lock-fill"></i></div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="module-card" style="opacity:0.6; cursor:default;">
                <span class="card-icon"><i class="bi bi-capsule-pill"></i></span>
                <h4>Tratamientos</h4>
                <p>Registra y da seguimiento a los tratamientos médicos aplicados en cada consulta.</p>
                <div class="card-arrow" style="color:#aaa">Próximamente <i class="bi bi-lock-fill"></i></div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="module-card" style="opacity:0.6; cursor:default;">
                <span class="card-icon"><i class="bi bi-person-badge-fill"></i></span>
                <h4>Veterinarios</h4>
                <p>Administra el personal médico, sus especialidades y disponibilidad para atención.</p>
                <div class="card-arrow" style="color:#aaa">Próximamente <i class="bi bi-lock-fill"></i></div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="module-card" style="opacity:0.6; cursor:default;">
                <span class="card-icon"><i class="bi bi-diagram-3-fill"></i></span>
                <h4>Especies</h4>
                <p>Catálogo de especies atendidas: perros, gatos, aves, roedores y reptiles.</p>
                <div class="card-arrow" style="color:#aaa">Próximamente <i class="bi bi-lock-fill"></i></div>
            </div>
        </div>
    </div>
</section>
