@model VeterinariaApp.Models.Mascota

@{
    ViewData["Title"] = "Registrar Mascota";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-plus-circle-fill"></i> Registrar Nueva Mascota</h1>
        <p>Complete el formulario para agregar un paciente al sistema</p>
    </div>
</div>

<div class="main-content">
    <div class="vet-form-card">
        <h3><i class="bi bi-clipboard2-pulse-fill"></i> Datos del Paciente</h3>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="border-radius:8px;font-size:0.9rem;"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label">
                        <i class="bi bi-tag-fill" style="color:var(--vet-green)"></i> Nombre de la mascota
                    </label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Rex" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Peso" class="form-label">
                        <i class="bi bi-speedometer2" style="color:var(--vet-green)"></i> Peso (kg)
                    </label>
                    <input asp-for="Peso" class="form-control" placeholder="Ej: 12.5" type="number" step="0.1" />
                    <span asp-validation-for="Peso" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaNacimiento" class="form-label">
                        <i class="bi bi-calendar3" style="color:var(--vet-green)"></i> Fecha de nacimiento
                    </label>
                    <input asp-for="FechaNacimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EspecieId" class="form-label">
                        <i class="bi bi-diagram-3-fill" style="color:var(--vet-green)"></i> Especie
                    </label>
                    <select asp-for="EspecieId" class="form-select" asp-items="ViewBag.EspecieId">
                        <option value="">-- Seleccione especie --</option>
                    </select>
                    <span asp-validation-for="EspecieId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="DuenoId" class="form-label">
                        <i class="bi bi-person-fill" style="color:var(--vet-green)"></i> Propietario
                    </label>
                    <select asp-for="DuenoId" class="form-select" asp-items="ViewBag.DuenoId">
                        <option value="">-- Seleccione propietario --</option>
                    </select>
                    <span asp-validation-for="DuenoId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div style="display:flex;align-items:center;gap:10px;background:#F1F8F1;padding:14px;border-radius:8px;border:2px solid #C8E6C9;">
                        <input class="form-check-input" asp-for="Activo" style="width:20px;height:20px;accent-color:var(--vet-green);" />
                        <label class="form-label mb-0" style="font-weight:600;color:var(--vet-green-dark)">
                            <i class="bi bi-check-circle-fill"></i> Mascota activa en el sistema
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-vet-primary">
                    <i class="bi bi-floppy-fill"></i> Guardar Mascota
                </button>
                <a asp-action="Index" class="btn-vet-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
