@model VeterinariaApp.Models.Ciudad
@{ ViewData["Title"] = "Detalles Ciudad"; }
<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-card-text"></i> Detalles de Ciudad</h1>
    </div>
</div>
<div class="main-content">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <h4 class="mb-4 text-primary"><i class="bi bi-info-circle"></i> Información General</h4>
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted mb-3">Nombre</dt>
                        <dd class="col-sm-8 fw-bold mb-3">@Model.Nombre</dd>                    </dl>
                    <hr class="my-4 text-muted">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-light btn-lg px-4" style="border-radius:10px;"><i class="bi bi-arrow-left"></i> Volver</a>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning btn-lg px-5 text-white" style="border-radius:10px;">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
