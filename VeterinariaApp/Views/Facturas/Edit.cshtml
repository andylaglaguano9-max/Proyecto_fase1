@model VeterinariaApp.Models.Factura
@{ ViewData["Title"] = "Editar Factura"; }
<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-pencil-square"></i> Editar: Factura</h1>
    </div>
</div>
<div class="main-content">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-4">
                            <label asp-for="FechaEmision" class="form-label fw-bold text-muted"></label>
                            <input asp-for="FechaEmision" class="form-control form-control-lg bg-light border-0" style="border-radius:10px;" />
                            <span asp-validation-for="FechaEmision" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Total" class="form-label fw-bold text-muted"></label>
                            <input asp-for="Total" class="form-control form-control-lg bg-light border-0" style="border-radius:10px;" />
                            <span asp-validation-for="Total" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Estado" class="form-label fw-bold text-muted"></label>
                            <input asp-for="Estado" class="form-control form-control-lg bg-light border-0" style="border-radius:10px;" />
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="DuenoId" class="form-label fw-bold text-muted"></label>
                            <select asp-for="DuenoId" class="form-select form-select-lg bg-light border-0" style="border-radius:10px;" asp-items="ViewBag.DuenoId"></select>
                        </div>                        <div class="d-flex justify-content-between mt-5">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4" style="border-radius:10px;"><i class="bi bi-arrow-left"></i> Volver</a>
                            <button type="submit" class="btn btn-warning btn-lg px-5 text-white" style="border-radius:10px;">
                                <i class="bi bi-save"></i> Actualizar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
