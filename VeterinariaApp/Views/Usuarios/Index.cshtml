@model IEnumerable<VeterinariaApp.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold text-dark m-0" style="font-family: 'Outfit', sans-serif; font-size: 2.2rem;">
            <i class="bi bi-people-fill text-primary me-2"></i>Gestión de Usuarios
        </h1>
        <p class="text-muted mt-1 mb-0">Administra los accesos, roles y el estado de las cuentas del sistema.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 12px; border-left: 5px solid #198754;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 12px; border-left: 5px solid #dc3545;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f1f5f9; border-bottom: 2px solid #e2e8f0;">
                    <tr>
                        <th class="px-4 py-3 text-secondary fw-bold" style="font-size: 0.80rem; letter-spacing: 0.8px; text-transform: uppercase;">ID</th>
                        <th class="px-4 py-3 text-secondary fw-bold" style="font-size: 0.80rem; letter-spacing: 0.8px; text-transform: uppercase;">Usuario (Correo)</th>
                        <th class="px-4 py-3 text-secondary fw-bold text-center" style="font-size: 0.80rem; letter-spacing: 0.8px; text-transform: uppercase;">Estado</th>
                        <th class="px-4 py-3 text-secondary fw-bold text-center" style="font-size: 0.80rem; letter-spacing: 0.8px; text-transform: uppercase;">Rol Actual</th>
                        <th class="px-4 py-3 text-secondary fw-bold text-end" style="font-size: 0.80rem; letter-spacing: 0.8px; text-transform: uppercase;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-bottom" style="transition: all 0.2s;">
                            <td class="px-4 py-3 fw-bold text-muted">#@item.Id</td>
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                    <div class="fw-semibold text-dark">@item.Username</div>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if(item.Activo)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold" style="font-size: 0.8rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-bold" style="font-size: 0.8rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> Inactivo</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                @{
                                    var rolBadgeClass = item.Rol == "Admin" ? "bg-primary" : (item.Rol == "Doctor" ? "bg-info text-dark" : "bg-secondary");
                                    var rolIcon = item.Rol == "Admin" ? "bi-shield-lock-fill" : (item.Rol == "Doctor" ? "bi-heart-pulse-fill" : "bi-person-badge-fill");
                                }
                                <span class="badge @rolBadgeClass px-3 py-2 rounded-pill fw-bold" style="font-size: 0.8rem;">
                                    <i class="bi @rolIcon me-1"></i> @item.Rol
                                </span>
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    <!-- Formulario para cambiar de rol rápido -->
                                    <form asp-action="CambiarRol" method="post" class="d-flex align-items-center m-0">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <select name="nuevoRol" class="form-select form-select-sm border-0 bg-light fw-medium text-secondary" style="border-radius: 8px; width: 110px; cursor: pointer;" onchange="this.form.submit()">
                                            <!option value="Usuario" @(item.Rol == "Usuario" ? "selected" : "")>Usuario</!option>
                                            <!option value="Doctor" @(item.Rol == "Doctor" ? "selected" : "")>Doctor</!option>
                                            <!option value="Admin" @(item.Rol == "Admin" ? "selected" : "")>Admin</!option>
                                        </select>
                                    </form>

                                    <!-- Botones CRUD -->
                                    <div class="btn-group shadow-sm" role="group" style="border-radius: 8px;">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            @if(item.Activo)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar" style="border-left: 0; border-right: 0; border-radius: 0;">
                                                    <i class="bi bi-pause-circle-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Activar" style="border-left: 0; border-right: 0; border-radius: 0;">
                                                    <i class="bi bi-play-circle-fill"></i>
                                                </button>
                                            }
                                        </form>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
