@model VeterinariaApp.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-danger m-0" style="font-family: 'Outfit', sans-serif;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar Usuario
    </h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill shadow-sm">
        <i class="bi bi-arrow-left"></i> Volver a la Lista
    </a>
</div>

<div class="alert alert-warning" role="alert">
  <h4 class="alert-heading"><i class="bi bi-exclamation-circle-fill"></i> ¡Atención!</h4>
  <p>Estás a punto de eliminar lógicamente este usuario del sistema. Ya no podrá iniciar sesión.</p>
  <hr>
  <p class="mb-0">¿Estás seguro que deseas proceder con la eliminación?</p>
</div>

<div class="card shadow-sm border-0 rounded-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
    <div class="card-body p-4">
        
        <dl class="row mb-0">
            <dt class="col-sm-3 fw-bold text-muted">ID</dt>
            <dd class="col-sm-9 fw-bold">#@Model.Id</dd>

            <dt class="col-sm-3 fw-bold text-muted">Correo Electrónico</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3 fw-bold text-muted">Rol Asignado</dt>
            <dd class="col-sm-9">
                @{
                    var rolBadgeClass = Model.Rol == "Admin" ? "bg-primary" : (Model.Rol == "Doctor" ? "bg-info" : "bg-secondary");
                }
                <span class="badge @rolBadgeClass rounded-pill">@Model.Rol</span>
            </dd>

            <dt class="col-sm-3 fw-bold text-muted">Fecha de Creación</dt>
            <dd class="col-sm-9">@Model.FechaCreacion.ToLocalTime().ToString("g")</dd>
        </dl>

        <hr class="my-4" />

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light rounded-pill shadow-sm px-4">Cancelar</a>
                <button type="submit" class="btn btn-danger rounded-pill shadow-sm px-4">
                    <i class="bi bi-trash-fill me-1"></i> Eliminar Usuario
                </button>
            </div>
        </form>
    </div>
</div>
