@model VeterinariaApp.Models.Proveedor
@{ ViewData["Title"] = "Eliminar Proveedor"; }
<div class="page-header" style="background: linear-gradient(135deg, #EF5350, #E53935);">
    <div class="container">
        <h1><i class="bi bi-exclamation-triangle-fill"></i> Eliminar Registro</h1>
    </div>
</div>
<div class="main-content">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-danger rounded-4" style="border-width:2px;">
                <div class="card-body p-5 text-center">
                    <i class="bi bi-trash text-danger" style="font-size: 4rem;"></i>
                    <h3 class="mt-3 mb-4 text-danger">Â¿Estás seguro de eliminar este Proveedor?</h3>
                    <p class="text-muted">Esta acción realizará un borrado lógico (quedará inactivo).</p>
                    
                    <div class="bg-light p-4 rounded-3 text-start mb-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted mb-2">Nombre</dt>
                            <dd class="col-sm-8 fw-bold mb-2">@Model.Nombre</dd>
                            <dt class="col-sm-4 text-muted mb-2">Contacto</dt>
                            <dd class="col-sm-8 fw-bold mb-2">@Model.Contacto</dd>
                            <dt class="col-sm-4 text-muted mb-2">Telefono</dt>
                            <dd class="col-sm-8 fw-bold mb-2">@Model.Telefono</dd>                        </dl>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4" style="border-radius:10px;"><i class="bi bi-x"></i> Cancelar</a>
                            <button type="submit" class="btn btn-danger btn-lg px-5" style="border-radius:10px;">
                                <i class="bi bi-trash3-fill"></i> Sí, Eliminar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
