@model IEnumerable<VeterinariaApp.Models.Producto>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Productos";
    var rol = HttpContextAccessor.HttpContext?.Session.GetString("Rol") ?? "";
}

<div class="page-header mb-4">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold text-dark m-0" style="font-family: 'Outfit', sans-serif;">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>@(rol == "Usuario" ? "Tienda de Productos" : "Gestión de Productos")
            </h1>
            <p class="text-muted mt-1 mb-0">@(rol == "Usuario" ? "Encuentra lo mejor para el cuidado de tu mascota." : "Inventario de tienda y control de stock.")</p>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 12px; border-left: 5px solid #198754;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 12px; border-left: 5px solid #dc3545;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (rol == "Usuario")
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden" style="transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="bg-light d-flex align-items-center justify-content-center p-4" style="height: 180px;">
                        <i class="bi bi-bag-heart-fill text-primary opacity-50" style="font-size: 5rem;"></i>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark mb-1">@item.Nombre</h5>
                        <p class="card-text text-muted small mb-3">Ref: #@item.Id</p>
                        
                        <div class="d-flex justify-content-between align-items-end mt-auto">
                            <div>
                                <span class="fs-4 fw-bold text-primary">$@item.Precio.ToString("0.00")</span>
                            </div>
                            <span class="badge @(item.Stock > 0 ? "bg-success" : "bg-danger") bg-opacity-10 @(item.Stock > 0 ? "text-success" : "text-danger") rounded-pill px-3 py-2">
                                @(item.Stock > 0 ? $"{item.Stock} en stock" : "Agotado")
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 p-3 pt-0">
                        @if (item.Stock > 0)
                        {
                            <form asp-action="Comprar" method="post" class="m-0">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm">
                                    <i class="bi bi-cart-plus-fill me-2"></i> Comprar Ahora
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100 rounded-pill fw-bold py-2" disabled>
                                <i class="bi bi-x-circle-fill me-2"></i> Agotado
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- VISTA DE ADMINISTRADOR / DOCTOR (CRUD) -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h5 class="m-0 fw-bold text-dark"><i class="bi bi-card-list me-2"></i>Lista de Productos</h5>
                
                <div class="d-flex gap-2 flex-wrap">
                    <form method="get" asp-action="Index" class="d-flex gap-2">
                        <div class="input-group shadow-sm" style="border-radius: 50px; overflow: hidden; max-width: 250px;">
                            <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control border-0 bg-white" placeholder="Buscar..." />
                        </div>
                        
                        <select name="orden" class="form-select border-0 shadow-sm" style="border-radius: 50px; max-width: 180px; cursor: pointer;" onchange="this.form.submit()">
                            <option value="">Ordenar por...</option>
                            <!option value="recientes" @(ViewBag.OrdenActual == "recientes" ? "selected" : "")>Más Recientes</!option>
                            <!option value="antiguos" @(ViewBag.OrdenActual == "antiguos" ? "selected" : "")>Más Antiguos</!option>
                            <!option value="az" @(ViewBag.OrdenActual == "az" ? "selected" : "")>A-Z</!option>
                            <!option value="za" @(ViewBag.OrdenActual == "za" ? "selected" : "")>Z-A</!option>
                        </select>
                        <button type="submit" class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="bi bi-filter"></i></button>
                        @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
                        {
                            <a asp-action="Index" class="btn btn-danger rounded-pill px-3 shadow-sm"><i class="bi bi-x-lg"></i></a>
                        }
                    </form>
                    <a asp-action="Create" class="btn btn-warning rounded-pill fw-bold text-dark shadow-sm px-4">
                        <i class="bi bi-plus-lg me-1"></i> Nuevo
                    </a>
                </div>
            </div>
        </div>
        
        <div class="card-body p-0 mt-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Nombre</th>
                            <th class="px-4 py-3 text-secondary fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Precio</th>
                            <th class="px-4 py-3 text-secondary fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Stock</th>
                            <th class="px-4 py-3 text-secondary fw-bold text-uppercase text-end" style="font-size: 0.8rem; letter-spacing: 0.5px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="px-4 py-3 fw-semibold text-dark">@item.Nombre</td>
                                <td class="px-4 py-3 text-success fw-bold">$@item.Precio.ToString("0.00")</td>
                                <td class="px-4 py-3">
                                    <span class="badge @(item.Stock > 10 ? "bg-primary" : (item.Stock > 0 ? "bg-warning" : "bg-danger")) rounded-pill px-3 py-2">
                                        @item.Stock uds
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <div class="btn-group shadow-sm" style="border-radius: 8px;">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- PAGINACIÓN -->
@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Page navigation" class="mt-4 d-flex justify-content-center">
        <ul class="pagination pagination-lg shadow-sm" style="border-radius: 12px; overflow: hidden;">
            @if (ViewBag.PaginaActual > 1)
            {
                <li class="page-item">
                    <a class="page-link text-primary" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)" asp-route-buscar="@ViewBag.Buscar"><i class="bi bi-chevron-left"></i></a>
                </li>
            }
            
            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link @(i == ViewBag.PaginaActual ? "bg-primary border-primary text-white" : "text-dark")" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@ViewBag.Buscar">@i</a>
                </li>
            }
            
            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link text-primary" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)" asp-route-buscar="@ViewBag.Buscar"><i class="bi bi-chevron-right"></i></a>
                </li>
            }
        </ul>
    </nav>
}
